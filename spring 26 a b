#include <stdio.h>
#include <limits.h>

int main()
{
    int n;
    scanf("%d", &n);

    long long x;
    long long first = LLONG_MAX;
    long long second = LLONG_MAX;

    for(int i = 0; i < n; i++)
    {
        scanf("%lld", &x);

        if(x < first)
        {
            second = first;
            first = x;
        }
        else if(x < second)
        {
            second = x;
        }
    }

    printf("%lld\n", second);

    return 0;
}
